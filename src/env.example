# Configuration SMTP pour l'envoi des candidatures (lib/utils/email.js).
# Sans ces variables, l'application fonctionne en mode "jsonTransport" :
# le formulaire répond normalement mais aucun email n'est réellement envoyé
# (utile en développement local).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mouvement JE" <no-reply@ctje.tn>

# Adresse qui reçoit les candidatures (par défaut : integration.jet.tn@gmail.com)
CANDIDATURE_RECIPIENT=integration.jet.tn@gmail.com

# URL publique finale du site (sans slash final), utilisée pour les
# métadonnées SEO/OpenGraph/Twitter, robots.txt et sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.jetunisie.com

# Adresse qui reçoit les avis de satisfaction UX/UI (KPI 4). Si absente,
# retombe sur CANDIDATURE_RECIPIENT.
SATISFACTION_RECIPIENT=integration.jet.tn@gmail.com
